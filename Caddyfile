# SITE_ADDRESS: dominio pubblico (certificato Let's Encrypt automatico)
# oppure localhost / IP (certificato dalla CA interna di Caddy).
{$SITE_ADDRESS:localhost} {
	# Per un hostname di LAN (es. cam.lan) decommenta:
	# tls internal

	# Opzionale: password (genera l'hash con `caddy hash-password`)
	# basic_auth {
	# 	utente <hash>
	# }

	# "mjpeg-proxy" e' il nome del container del proxy sulla rete Docker condivisa.
	reverse_proxy mjpeg-proxy:8080 {
		flush_interval -1   # niente buffering: i frame MJPEG partono subito
	}
}
